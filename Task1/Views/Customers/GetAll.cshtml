
<div class="container mt-4">
    <h2>Customers Inventory</h2>
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Order Disc</th>
                <th>Order Price ($)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.Customers)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.OrderDiscription</td>
                    <td>@item.OrderPrice</td>
                </tr>
            }
        </tbody>
    </table>
</div>
